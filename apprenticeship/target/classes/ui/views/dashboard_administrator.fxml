<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.controllers.DashboardAdministratorController"
            style="-fx-background-color: #f0f4f8;">

    <!-- ═══ EN-TÊTE ═══ -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT"
              style="-fx-padding: 15 20; -fx-background-color: #1a252f;">
            <Label fx:id="adminLabel"
                   style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="statsLabel"
                   style="-fx-text-fill: #bdc3c7; -fx-font-size: 12;" />
            <Button text="⬅ Déconnexion"
                    onAction="#logout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-padding: 8 15; -fx-background-radius: 5;" />
        </HBox>
    </top>

    <!-- ═══ MENU GAUCHE ═══ -->
    <left>
        <VBox spacing="12"
              style="-fx-padding: 20; -fx-background-color: #2c3e50; -fx-min-width: 180;">

            <Label text="VUE D'ENSEMBLE"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 11; -fx-font-weight: bold;" />

            <Button text="📋 Inscriptions"
                    prefWidth="160"
                    onAction="#showRegistrations"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-padding: 10; -fx-background-radius: 5;" />

            <Button text="📅 Créneaux"
                    prefWidth="160"
                    onAction="#showTimeSlots"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-padding: 10; -fx-background-radius: 5;" />

            <Button text="👶 Enfants"
                    prefWidth="160"
                    onAction="#showChildren"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-padding: 10; -fx-background-radius: 5;" />

            <Button text="🔔 Notifications"
                    prefWidth="160"
                    onAction="#showNotifications"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-padding: 10; -fx-background-radius: 5;" />
        </VBox>
    </left>

    <!-- ═══ ZONE CENTRALE ═══ -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <!-- Inscriptions -->
            <VBox spacing="6"
                  style="-fx-background-color: white; -fx-padding: 12;
                         -fx-background-radius: 7; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),6,0,0,2);">
                <Label text="📋 Toutes les inscriptions"
                       style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <ListView fx:id="registrationsListView" prefHeight="120"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;" />
            </VBox>

            <!-- Créneaux -->
            <VBox spacing="6"
                  style="-fx-background-color: white; -fx-padding: 12;
                         -fx-background-radius: 7; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),6,0,0,2);">
                <Label text="📅 Créneaux disponibles"
                       style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <ListView fx:id="timeSlotsListView" prefHeight="140"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;" />
            </VBox>

            <!-- Enfants + Notifications côte à côte -->
            <HBox spacing="15">
                <VBox spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-padding: 12;
                             -fx-background-radius: 7; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),6,0,0,2);">
                    <Label text="👶 Enfants inscrits"
                           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <ListView fx:id="childrenListView" prefHeight="120"
                              style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;" />
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-padding: 12;
                             -fx-background-radius: 7; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),6,0,0,2);">
                    <Label text="🔔 Notifications"
                           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <ListView fx:id="notificationsListView" prefHeight="120"
                              style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;" />
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>
